//@version=6
indicator("Jamal OB v0.41.0", shorttitle = "JOB0.41", overlay = true, max_boxes_count = 50)

// ════════════════ Identity ════════════════
SCRIPT_V = "0.41.0"

// ════════════════ Inputs ════════════════
max_lookback = input.int(200, "Walk-back max lookback (bars)", minval = 10)
use_fill     = input.bool(false, "Gap close-fill trigger",
     tooltip = "OFF (default): the line moves only on new lows (green) / new highs (red). ON: adds the CLOSE-FILL trigger. A candle that CLOSES below the bottom of a bull gap (fully closing the gap - any margin) relocates the green line via the normal full walk-back. Dipping into a gap without closing through it does nothing. Bear mirror: a close above a bear gap's top moves the red line. v0.41.0 QUEUE: only the NEWEST zone not yet closed through is armed at any time; when it fires, the next-newest becomes armed on the following bar. One bar closing through several stacked zones therefore walks them one per bar instead of firing once for all of them. Side effect: a zone price never closes back through sits at the head of the queue and blocks the older zones behind it.")
use_lit      = input.bool(false, "Bright-line trigger",
     tooltip = "OFF (default): no effect. ON: adds a THIRD Trigger to BOTH lines, mirrored (v0.39.0 shipped the red→green half only, as use_redlit; v0.40.0 renames it and adds the mirror). RED turns BRIGHT (first confirmed close below the upper line since its last relocation) → fires a normal bull walk-back, moving the GREEN line. GREEN turns BRIGHT (first confirmed close above the lower line) → fires a normal bear walk-back, moving the RED line. Same walks, same guard updates, same eligibility rule (a line holds if its walk finds no series). One-shot per line placement, because the reclaim latch only arms once between that line's own relocations. Tie-break when both fire on one bar: red→green resolves first and cancels the green's own lit event.")
start_ts     = input.time(timestamp("1 Aug 2022 00:00 +0000"), "State start date",
     tooltip = "The OB state machine ignores all bars before this date: no sweeps fire and walk-backs clamp here. Default = ~4 years back; symbols younger than that simply start at their first bar. Caps how stale a line can be. NOTE: if a device loads less history than this (e.g. mobile), the lines can differ across devices — tighten the date if that matters.")

// ════════════════ Vocabulary (v0.33.0; v0.38.0 close-fill; v0.40.0 bright-line) ════════════════
// ORIGIN  — the candle that starts the down series; its open is the line.
// TRIGGER — any candle that fires a walk-back. Three trigger events (no
//           established/search states, no resets — all removed in v0.33):
//             1. BOTTOM SWEEP — price trades below the current series' lowest
//                low (the guard). Intrabar; this is the lower-low chain.
//                ALWAYS ON — by default this is the ONLY way the line moves.
//                v0.35.0: the guard SEEDS from the first bar after the start
//                date (its low), so the chain bootstraps itself — at defaults
//                the line is simply THE WALK-BACK OF THE LOWEST LOW SINCE THE
//                START DATE (red mirror: the highest high).
//             2. GAP CLOSE-FILL (v0.38.0, single toggle, default OFF;
//                REPLACES the v0.36/v0.37 gap+pivot combo — the pivot/swing
//                machinery is deleted. Calibrated on the 21-tap BTC-1D
//                walk-back sandbox, 2026-08-06):
//                the FIRST candle to CLOSE below the bottom of a bull gap
//                (fully closing the gap — ANY margin, user-confirmed) is a
//                Trigger. Dipping into a gap without closing through does
//                NOTHING (Oct-3 / Mar-27 / Jun-30-2023 non-taps). Fires in
//                BOTH directions — catch-up during rallies (Sep-21, Oct-11,
//                Nov-14, Dec-11-2023 fixtures) and breakdown steps
//                (Dec-19-2022 fixture). One-shot per zone (on the close-fill,
//                tracked separately from the visual first-touch cap).
//                v0.41.0 QUEUE: only the NEWEST zone not yet closed through is
//                armed; firing it arms the next-newest on the FOLLOWING bar.
//                Replaces "every unmitigated zone armed at once". This CHANGES
//                the v0.38.0 sandbox calibration surface — see CHANGELOG for
//                which fixtures were re-checked and which were not.
//                v0.38.2: the walk-back is IDENTICAL for every trigger — the
//                full v0.17 3-candle-rule walk, never clamped or modified
//                (user directive: "the walk back logic should never have
//                changed"). The v0.38.0 previous-Trigger clamp and the
//                v0.38.1 0.5% threshold are both REVERTED. Known consequence:
//                the Dec-19-2022 fixture's fill walks to 17,804 (the level
//                already in force) and the line does not move there.
//             3. BRIGHT-LINE (v0.39.0 red→green; v0.40.0 adds the mirror —
//                single toggle `use_lit`, default OFF): the bar on which ONE
//                line turns BRIGHT is a Trigger for the OTHER line.
//                  RED bright (first confirmed close below the upper line
//                  since it last relocated) → normal f_walkback_bull → the
//                  GREEN line moves.
//                  GREEN bright (first confirmed close above the lower line)
//                  → normal f_walkback_bear → the RED line moves.
//                Nothing about either walk changes: same anchor convention
//                (the Trigger candle, or the bar before if it is the wrong
//                colour to seed), same guard update, same hold-on-na rule.
//                One-shot per line placement — v0.40.1: this requires the
//                RISING-EDGE guard (`not *_closed_below/above`) in the LIT
//                stage. Without it the branch is a level test that re-fires
//                every confirmed bar beyond the line. The two are
//                mutually recursive, so the bar is evaluated in three stages
//                — see EVALUATION ORDER below.
// BOTTOM  — the walked series' lowest low; stored as the GUARD. Sweeping the
//           guard (not the Trigger candle's own wick — v0.33.0 placement
//           guard fix) is what makes the next candle a new Trigger.
// The line is simply the walk-back of the most recent Trigger: it moves ONLY
// when a new Trigger fires, and only if the walk-back finds a real down-series
// behind it (else the line holds). Bear side is the exact high↔low mirror.

// ════════════════ Bullish walk-back (lower line = Origin's open) ════════════════
// From the anchor bar at offset s0 (the Trigger candle if it is RED; the bar
// BEFORE it if the Trigger is green), walk backward over the contiguous
// down-leg. Returns [open_R, leg_lo]:
//   open_R = highest red open in the leg (the Origin's open = the line; when
//            the anchor is red it may be the anchor's own open),
//   leg_lo = lowest low over [stop-candle .. s0] (the series BOTTOM → guard).
// v0.17.0 3-CANDLE STOP rule (16-permutation table + inside-candle edge-case
// pass; real legs VVV / SOL 8h / SOL 1W): reds are in-leg (running max of red
// opens). At a GREEN counter G with OLDER neighbour L (bar i+1) and NEWER
// neighbour R (bar i-1, toward the Trigger):
//   STOP iff  G.high > L.high  OR  ( R.high > G.high  AND  G.low is NOT between
//   L.low and R.low ) — R rises above G while G's low sits OUTSIDE the L–R low
//   band (i.e. R ENGULFS G, or G is a swing low). Else PAUSE, keep walking.
// v0.29.0: a FLAT doji (close == open) follows the same rule as a green.
f_walkback_bull(int maxlb, int s0, int t0) =>
    float best_open = close[s0] < open[s0] ? open[s0] : na   // seed R only if anchor bar is red
    float leg_lo    = low[s0]
    for i = s0 + 1 to s0 + maxlb
        if na(time[i]) or time[i] < t0
            break                                   // clamp: stop at the start date AND at the chart's first loaded bar (a bar past the edge has na values — folding its na low into leg_lo would wipe out the guard; v0.33.1)
        leg_lo := math.min(leg_lo, low[i])          // series BOTTOM includes every scanned bar, incl. the stop-candle
        if close[i] < open[i]                        // red → in leg
            best_open := na(best_open) ? open[i] : math.max(best_open, open[i])
            continue
        bool a_hi = high[i] > high[i + 1]            // G.high > L.high (older)
        bool b_hi = high[i] > high[i - 1]            // G.high > R.high (newer)
        bool c_lo = low[i]  > low[i + 1]             // G.low  > L.low
        bool d_lo = low[i]  > low[i - 1]             // G.low  > R.low
        if close[i] >= open[i] and not a_hi and (b_hi or (c_lo != d_lo))
            continue                                // green/doji pass-through: not a local top; pokes above R OR its low is BETWEEN the two lows → keep walking
        break                                       // green/doji STOPS: local top (high>L), OR R above it with its low OUTSIDE the L–R low band (R engulfs / swing low)
    [best_open, leg_lo]

// ════════════════ Bearish walk-back (upper line = Origin's open) ════════════════
// Mirror: anchor at s0 (the Trigger candle if GREEN; the bar before if red).
// Returns [open_R, leg_hi]: open_R = lowest green open (supply line);
// leg_hi = highest high over [stop-candle .. s0] (the series TOP → guard).
// v0.17.0 3-CANDLE STOP rule — EXACT MIRROR of the bull side (high↔low).
// v0.29.0: a FLAT doji follows the same rule as the red counter.
f_walkback_bear(int maxlb, int s0, int t0) =>
    float best_open = close[s0] > open[s0] ? open[s0] : na   // seed R only if anchor bar is green
    float leg_hi    = high[s0]
    for i = s0 + 1 to s0 + maxlb
        if na(time[i]) or time[i] < t0
            break                                   // clamp: stop at the start date AND at the chart's first loaded bar (v0.33.1 — see bull side)
        leg_hi := math.max(leg_hi, high[i])         // series TOP includes every scanned bar, incl. the stop-candle
        if close[i] > open[i]                        // green → in leg
            best_open := na(best_open) ? open[i] : math.min(best_open, open[i])
            continue
        bool a_lo = low[i]  < low[i + 1]             // RED.low < L.low (older)
        bool b_lo = low[i]  < low[i - 1]             // RED.low < R.low (newer)
        bool c_hi = high[i] < high[i + 1]            // RED.high < L.high
        bool d_hi = high[i] < high[i - 1]            // RED.high < R.high
        if close[i] <= open[i] and not a_lo and (b_lo or (c_hi != d_hi))
            continue                                // red/doji pass-through: not a local bottom; R drops below it OR its high is BETWEEN the two highs → keep walking
        break                                       // red/doji STOPS: local bottom (low<L), OR R below it with high OUTSIDE the L–R high band (R engulfs / swing high)
    [best_open, leg_hi]

// ════════════════ State ════════════════
bool active = time >= start_ts                       // machine is dead before the start date

var float lower_line    = na
var float upper_line    = na
var float bull_guard_lo = na       // the series BOTTOM from the last placement — trading below it = new Trigger (chain)
var float bear_guard_hi = na       // the series TOP — trading above it = new Trigger
var bool  bull_touched      = false   // level retested from above (latched until reloc; colour only)
var bool  bull_closed_above = false   // level reclaimed (armed; colour only)
var bool  bear_touched      = false
var bool  bear_closed_below = false
var int   redlit_n         = 0     // diagnostic: how many times the RED line has turned BRIGHT
var int   redlit_reloc_n   = 0     // diagnostic: how many of those actually moved the GREEN line
var int   greenlit_n       = 0     // v0.40.0 mirror: how many times the GREEN line has turned BRIGHT
var int   greenlit_reloc_n = 0     // v0.40.0 mirror: how many of those actually moved the RED line
var int   fill_bull_n  = 0         // v0.41.0 diagnostic: close-fill trigger events (bars), bull side
var int   fill_bull_rl = 0         // v0.41.0 diagnostic: of those, the ones that SOLELY moved the green line
var int   fill_bear_n  = 0
var int   fill_bear_rl = 0
                                   // A *_reloc_n counts only when the bright trigger was the SOLE cause
                                   // (that side did not already relocate on a sweep/fill this bar) AND the
                                   // walk found a series. The gap to *_n is the na-rate — the calibration number.
var array<box>  bull_fvg_boxes = array.new<box>()    // light-green support gaps (visual: last 5, capped on first touch)
var array<bool> bull_fvg_mit   = array.new<bool>()   // parallel — has box[i] been swept (capped, no longer extends)?
var array<box>  bear_fvg_boxes = array.new<box>()    // light-red resistance gaps
var array<bool> bear_fvg_mit   = array.new<bool>()
// v0.38.0 close-fill trigger bookkeeping — SEPARATE from the visual boxes: a zone stays
// fill-armed until a candle CLOSES beyond it, which can happen long after the first
// touch capped the drawn box (the Aug-17-2023 fixture filled two-month-old June zones).
var array<float> bull_fill_bot  = array.new<float>() // bull zone bottoms awaiting a close below
var array<bool>  bull_fill_done = array.new<bool>()
var array<float> bear_fill_top  = array.new<float>() // bear zone tops awaiting a close above
var array<bool>  bear_fill_done = array.new<bool>()

// ════════════════ FVG zones (chart TF) — last 5 FORMED per side, shaded fill only; a swept zone is CAPPED at the sweeping candle (kept, not deleted) ════════════════
// v0.28.0: MITIGATION RUNS BEFORE DETECTION — a zone cannot be swept by the
// candle that CREATES it; the sweep is the first LATER candle to enter it.
// v0.32.0: detection lands on the PATTERN'S OWN COMPLETING CLOSE — the
// confirmed bar itself is the third candle (`low > high[2]` / `high < low[2]`).
// Same gap, same boundaries, zero-repaint (the block is close-gated). (The
// 4-TF DW latch below keeps the old [1]/[3] offsets — un-gated, display only.)
bool bull_fvg_touched = false          // price FIRST entered a bull FVG this bar (fires once per zone) — visual capping only
bool bear_fvg_touched = false
bool bull_fill_evt    = false          // v0.38.0: a candle CLOSED below a bull zone's bottom for the first time → close-fill Trigger
bool bear_fill_evt    = false
if barstate.isconfirmed and active
    // v0.41.0 QUEUE ("reading A"): only the NEWEST unmitigated zone is armed. Scan from the
    // newest end for the first zone not yet closed through; that one, and only that one, can
    // fire this bar. When it does it is marked done and the next-newest becomes armed on the
    // FOLLOWING bar — so one bar closing through several stacked zones no longer fires them
    // all at once, it walks them one per bar. Consequence (inherent, not a bug): a zone price
    // never closes back through stays at the head of the queue forever and blocks every older
    // zone behind it. Pre-0.41 behaviour was: every unmitigated zone armed simultaneously,
    // all of them closed through on one bar firing a single shared event.
    if array.size(bull_fill_bot) > 0    // any margin below the bottom counts — user-confirmed
        int kb = -1
        for i = array.size(bull_fill_bot) - 1 to 0
            if not array.get(bull_fill_done, i)
                kb := i
                break
        if kb >= 0 and close < array.get(bull_fill_bot, kb)
            array.set(bull_fill_done, kb, true)
            bull_fill_evt := true
            fill_bull_n   += 1
    if array.size(bear_fill_top) > 0
        int ks = -1
        for i = array.size(bear_fill_top) - 1 to 0
            if not array.get(bear_fill_done, i)
                ks := i
                break
        if ks >= 0 and close > array.get(bear_fill_top, ks)
            array.set(bear_fill_done, ks, true)
            bear_fill_evt := true
            fill_bear_n   += 1
    if array.size(bull_fvg_boxes) > 0   // sweep check FIRST: on the first touch (low ≤ zone top) cap the box at this candle + stop extending
        for i = 0 to array.size(bull_fvg_boxes) - 1
            box b = array.get(bull_fvg_boxes, i)
            if not array.get(bull_fvg_mit, i) and low <= box.get_top(b)
                box.set_right(b, bar_index)
                box.set_extend(b, extend.none)
                array.set(bull_fvg_mit, i, true)
                bull_fvg_touched := true
    if array.size(bear_fvg_boxes) > 0
        for i = 0 to array.size(bear_fvg_boxes) - 1
            box b = array.get(bear_fvg_boxes, i)
            if not array.get(bear_fvg_mit, i) and high >= box.get_bottom(b)
                box.set_right(b, bar_index)
                box.set_extend(b, extend.none)
                array.set(bear_fvg_mit, i, true)
                bear_fvg_touched := true
    if low > high[2]                    // THEN detect at THIS confirmed close: new bull FVG [high[2] .. low] — untouchable until the next bar
        array.push(bull_fvg_boxes, box.new(bar_index - 1, low, bar_index, high[2], border_width = 0, bgcolor = color.new(color.green, 78), extend = extend.right))
        array.push(bull_fvg_mit, false)
        if array.size(bull_fvg_boxes) > 5   // keep only the last 5 FORMED (swept ones still count)
            box.delete(array.shift(bull_fvg_boxes))
            array.shift(bull_fvg_mit)
        array.push(bull_fill_bot, high[2])  // fill bookkeeping keeps a deeper memory than the drawn boxes
        array.push(bull_fill_done, false)
        if array.size(bull_fill_bot) > 30
            array.shift(bull_fill_bot)
            array.shift(bull_fill_done)
    if high < low[2]                    // new bear FVG [high .. low[2]]
        array.push(bear_fvg_boxes, box.new(bar_index - 1, low[2], bar_index, high, border_width = 0, bgcolor = color.new(color.red, 78), extend = extend.right))
        array.push(bear_fvg_mit, false)
        if array.size(bear_fvg_boxes) > 5
            box.delete(array.shift(bear_fvg_boxes))
            array.shift(bear_fvg_mit)
        array.push(bear_fill_top, low[2])
        array.push(bear_fill_done, false)
        if array.size(bear_fill_top) > 30
            array.shift(bear_fill_top)
            array.shift(bear_fill_done)

// ════════════════ EVALUATION ORDER (v0.40.0) ════════════════
// The two BRIGHT triggers are MUTUALLY RECURSIVE — red-bright feeds the bull
// walk, green-bright feeds the bear walk, and each side's lit edge is itself
// gated on whether that side relocated this bar. No single top-to-bottom pass
// satisfies both. The bar is therefore evaluated in three stages:
//   PASS 1 — both sides relocate on Triggers 1-2 ONLY (sweep, close-fill).
//   LIT    — both freshness blocks run, each gated on its OWN side's pass-1
//            relocation exactly as in every prior version, raising
//            bear_lit_evt / bull_lit_evt on the arming edge.
//   PASS 2 — the cross triggers fire: red-bright → bull walk, green-bright →
//            bear walk. Each is SKIPPED if that side already relocated in
//            pass 1, and performs its own freshness reset when it lands.
// The pass-2 skip costs nothing: a walk-back's result depends only on its
// anchor bar (this bar, or the one before, chosen by candle colour), so a
// second walk on the same bar would return an identical level. That makes
// this structure behaviourally identical to v0.39.0 for red→green, and to
// v0.38.2 whenever use_lit is OFF.
// TIE-BREAK: if both lines go bright on the same bar, red→green resolves
// first and CANCELS the green's own lit event — the green line it lit against
// has just been replaced, so firing off it would be an artifact.

bool bull_prev_touched = bull_touched   // colour only — captured before any relocation
bool bear_prev_touched = bear_touched

// ──────────────── PASS 1: sweep + close-fill, both sides ────────────────
if active and na(bear_guard_hi)
    bear_guard_hi := high              // v0.35.0 seed: first active bar's high starts the record-high chain
if active and na(bull_guard_lo)
    bull_guard_lo := low               // v0.35.0 seed: first active bar's low starts the record-low chain
bool bear_wick = active and not na(bear_guard_hi) and high > bear_guard_hi   // Trigger 1: TOP sweep (intrabar chain)
bool bear_fill = active and use_fill and bear_fill_evt                       // Trigger 2: gap CLOSE-FILL (close above a bear zone's top)
bool bull_wick = active and not na(bull_guard_lo) and low < bull_guard_lo    // Trigger 1: BOTTOM sweep (intrabar chain)
bool bull_fill = active and use_fill and bull_fill_evt                       // Trigger 2: gap CLOSE-FILL (close below a bull zone's bottom)
bool bear_did_reloc = false
bool bull_did_reloc = false
if bear_wick or bear_fill
    int s0s = close > open ? 0 : 1
    [oRs, whi] = f_walkback_bear(max_lookback, s0s, start_ts)
    if not na(oRs)                     // eligible only if the walk-back finds a real supply (an up-series behind the entry)
        upper_line    := oRs
        bear_guard_hi := math.max(high, whi)
        bear_did_reloc := true
        if bear_fill and not bear_wick
            fill_bear_rl += 1          // v0.41.0: close-fill was the SOLE cause of this red move
if bull_wick or bull_fill
    int s0b = close < open ? 0 : 1
    [oRb, wlo] = f_walkback_bull(max_lookback, s0b, start_ts)
    if not na(oRb)                     // eligible only if the walk-back finds a real demand (a down-series behind the entry)
        lower_line    := oRb
        bull_guard_lo := math.min(low, wlo)
        bull_did_reloc := true
        if bull_fill and not bull_wick
            fill_bull_rl += 1          // v0.41.0: close-fill was the SOLE cause of this green move

// ──────────────── LIT: freshness edges (render state + Trigger 3 source) ────────────────
// BRIGHT = reclaimed and not retested since. Green: arms when a bar AFTER the
// setting bar CONFIRMS a close above the line (the arming bar's pass-through
// wick doesn't count, nor do pre-reclaim wicks from below). Once armed, the
// first low back at the line latches "touched" → dull until relocation (no
// re-arm). The FIRST touch bar itself stays bright (colour reads the prior
// bar's touched state). Red: exact mirror.
// v0.39.0 / v0.40.0: each arming edge also raises that side's *_lit_evt.
bool bear_lit_evt = false
bool bull_lit_evt = false
if bear_did_reloc
    bear_touched      := false
    bear_closed_below := false
else if not na(upper_line)
    if bear_closed_below and high >= upper_line
        bear_touched := true
    else if not bear_closed_below and not bear_touched and barstate.isconfirmed and close < upper_line
        bear_closed_below := true      // v0.40.1: `not bear_closed_below` makes this a RISING EDGE.
        bear_lit_evt      := true      // Without it the branch re-fires on EVERY confirmed bar closing
        redlit_n          += 1         // below the line (harmless pre-0.39 — it only re-set an already-true
                                       // latch — but v0.39 hung a Trigger on it: SOL 1W fired 26 weeks running
                                       // because price sat far under a 40.60 line, so `high >= upper_line`
                                       // never latched bear_touched. Colour behaviour is unchanged.
if bull_did_reloc
    bull_touched      := false
    bull_closed_above := false
else if not na(lower_line)
    if bull_closed_above and low <= lower_line
        bull_touched := true
    else if not bull_closed_above and not bull_touched and barstate.isconfirmed and close > lower_line
        bull_closed_above := true      // v0.40.1 rising-edge guard — exact mirror of the bear side above
        bull_lit_evt      := true
        greenlit_n        += 1

// ──────────────── PASS 2: cross (bright-line) triggers ────────────────
if use_lit and bear_lit_evt and not bull_did_reloc                           // RED bright → move the GREEN line
    int s0b2 = close < open ? 0 : 1
    [oRb2, wlo2] = f_walkback_bull(max_lookback, s0b2, start_ts)
    if not na(oRb2)
        lower_line        := oRb2
        bull_guard_lo     := math.min(low, wlo2)
        bull_did_reloc    := true
        bull_touched      := false     // relocated → green freshness resets, starts dull
        bull_closed_above := false
        bull_lit_evt      := false     // tie-break: the level it lit against is gone
        redlit_reloc_n    += 1
if use_lit and bull_lit_evt and not bear_did_reloc                           // GREEN bright → move the RED line
    int s0s2 = close > open ? 0 : 1
    [oRs2, whi2] = f_walkback_bear(max_lookback, s0s2, start_ts)
    if not na(oRs2)
        upper_line        := oRs2
        bear_guard_hi     := math.max(high, whi2)
        bear_did_reloc    := true
        bear_touched      := false     // relocated → red freshness resets, starts dull
        bear_closed_below := false
        greenlit_reloc_n  += 1

bool  bull_bright = bull_closed_above and not bull_prev_touched
bool  bear_bright = bear_closed_below and not bear_prev_touched
color lower_col   = bull_bright ? color.new(color.green, 0) : color.new(color.green, 60)
color upper_col   = bear_bright ? color.new(color.red, 0)   : color.new(color.red, 60)

// ════════════════ FVG identification (v0.7.0 — state only, NOT drawn) ════════════════
// 3-candle fair value gap latches for the Data Window, four timeframes (chart
// TF + D / W / M via request.security with internal [1..3] offsets +
// lookahead_on — the standard non-repaint idiom). The latch lives INSIDE the
// function (per-security-context var state). NOTE: the DRAWN boxes above
// detect one bar earlier (at the pattern's own completing close) — this latch
// keeps the lagged offsets because it is not close-gated. Display only.
f_fvg_latest() =>
    var float bb = na    // latest bull gap bot / top
    var float bt = na
    var float sb = na    // latest bear gap bot / top
    var float st = na
    if low[1] > high[3]
        bb := high[3]
        bt := low[1]
    if high[1] < low[3]
        sb := high[1]
        st := low[3]
    [bb, bt, sb, st]

[fvg_c_bull_bot, fvg_c_bull_top, fvg_c_bear_bot, fvg_c_bear_top] = f_fvg_latest()
[fvg_d_bull_bot, fvg_d_bull_top, fvg_d_bear_bot, fvg_d_bear_top] = request.security(syminfo.tickerid, "D", f_fvg_latest(), lookahead = barmerge.lookahead_on)
[fvg_w_bull_bot, fvg_w_bull_top, fvg_w_bear_bot, fvg_w_bear_top] = request.security(syminfo.tickerid, "W", f_fvg_latest(), lookahead = barmerge.lookahead_on)
[fvg_m_bull_bot, fvg_m_bull_top, fvg_m_bear_bot, fvg_m_bear_top] = request.security(syminfo.tickerid, "M", f_fvg_latest(), lookahead = barmerge.lookahead_on)

// ════════════════ Render ════════════════
plot(lower_line, "OB lower (demand — Origin's open)", lower_col, 2, plot.style_stepline)
plot(upper_line, "OB upper (supply — Origin's open)", upper_col, 2, plot.style_stepline)
plot(bull_bright ? 1 : 0, "DW lower fresh (1=bright)", display = display.data_window)
plot(bear_bright ? 1 : 0, "DW upper fresh (1=bright)", display = display.data_window)
plot(bear_lit_evt ? 1 : 0, "DW red-lit trigger", display = display.data_window)
plot(redlit_n, "DW red-lit count (cumulative)", display = display.data_window)
plot(redlit_reloc_n, "DW red-lit relocations", display = display.data_window)
plot(bull_lit_evt ? 1 : 0, "DW green-lit trigger", display = display.data_window)
plot(greenlit_n, "DW green-lit count (cumulative)", display = display.data_window)
plot(greenlit_reloc_n, "DW green-lit relocations", display = display.data_window)
plot(fill_bull_n,  "DW bull close-fill count", display = display.data_window)
plot(fill_bull_rl, "DW bull close-fill relocations", display = display.data_window)
plot(fill_bear_n,  "DW bear close-fill count", display = display.data_window)
plot(fill_bear_rl, "DW bear close-fill relocations", display = display.data_window)
plot(bull_guard_lo, "DW lower guard (series bottom)", display = display.data_window)
plot(bear_guard_hi, "DW upper guard (series top)", display = display.data_window)
plot(fvg_c_bull_top, "DW FVG chart bull top", display = display.data_window)
plot(fvg_c_bull_bot, "DW FVG chart bull bot", display = display.data_window)
plot(fvg_c_bear_top, "DW FVG chart bear top", display = display.data_window)
plot(fvg_c_bear_bot, "DW FVG chart bear bot", display = display.data_window)
plot(fvg_d_bull_top, "DW FVG D bull top", display = display.data_window)
plot(fvg_d_bull_bot, "DW FVG D bull bot", display = display.data_window)
plot(fvg_d_bear_top, "DW FVG D bear top", display = display.data_window)
plot(fvg_d_bear_bot, "DW FVG D bear bot", display = display.data_window)
plot(fvg_w_bull_top, "DW FVG W bull top", display = display.data_window)
plot(fvg_w_bull_bot, "DW FVG W bull bot", display = display.data_window)
plot(fvg_w_bear_top, "DW FVG W bear top", display = display.data_window)
plot(fvg_w_bear_bot, "DW FVG W bear bot", display = display.data_window)
plot(fvg_m_bull_top, "DW FVG M bull top", display = display.data_window)
plot(fvg_m_bull_bot, "DW FVG M bull bot", display = display.data_window)
plot(fvg_m_bear_top, "DW FVG M bear top", display = display.data_window)
plot(fvg_m_bear_bot, "DW FVG M bear bot", display = display.data_window)

// ════════════════ Version tag ════════════════
var table vt = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(vt, 0, 0, "Jamal OB v" + SCRIPT_V, text_color = color.white, bgcolor = color.new(color.black, 20))
