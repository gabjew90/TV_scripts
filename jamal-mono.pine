//@version=6
indicator("Jamal Mono v0.7.0", shorttitle = "JMono0.7", overlay = false,
     max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

// ════════════════ Identity ════════════════
SCRIPT_V = "0.7.0"

// ════════════════ What this is ════════════════
// A separate-pane candle chart of MONOLITHIC candles — the same grouping the
// jamal-ob `use_mono` walk-back uses, drawn so it can be read directly instead
// of inferred from levels.
//
// A mono = a run of consecutive same-colour bars merged into one candle:
//     open  = the run's FIRST (oldest) bar's open
//     close = the run's LAST (newest) bar's close
//     high  = highest high across the run
//     low   = lowest low across the run
// Colour convention matches the walk-back exactly: RED is close < open, so a
// FLAT DOJI (close == open) counts as GREEN.
//
// TWO RENDERERS (v0.2.0), chosen by `one_candle`:
//   ON  — ONE candle per mono, drawn with a box (body) + line (wick) so it can
//         span the whole run. A 4-bar run is one candle four bars wide.
//   OFF — the v0.1.0 renderer: `plotcandle` repeats the mono on every bar of
//         its run, so the run appears as a stair of growing candles. Pine's
//         plotcandle is one-value-per-bar and cannot span bars, which is the
//         whole reason the box renderer exists.
//
// X-AXIS ALIGNMENT: the box renderer uses `xloc.bar_time` with a sub-bar
// offset either side of the run, so a mono covering bars L..R is centred on
// exactly the span those bars occupy in the price pane above. Using
// `xloc.bar_index` instead would put the edges on bar CENTRES, making every
// mono half a bar narrow and collapsing single-bar monos to zero width. The
// offset assumes evenly spaced bars, which holds on 24/7 crypto; on a
// session-gapped symbol the edges drift across weekend/holiday gaps.
//
// NO LAG, NO LOOKAHEAD (v0.7.0). Every rule reads only the bar being drawn and
// state accumulated before it. The one-bar lag v0.4.0-v0.6.0 needed for the
// forward-absorb rule is gone with that rule.
//
// DRAWING LIMITS: 500 boxes and 500 lines, so the box renderer shows the most
// recent ~500 monos and TradingView drops older ones. On a chart with more
// monos than that (NEAR daily currently has ~1,085) the early history renders
// empty in one-candle mode. Switch the toggle off to see all of it.

// ════════════════ Inputs ════════════════
merge_inside = input.bool(false, "Merge inside candles into a mono", group = "Grouping", tooltip = "OFF (default): a run ends the moment the bar colour flips - the grouping the jamal-ob use_mono walk-back actually runs on. ON: an OPPOSITE-COLOUR bar that is INSIDE THE MONO SO FAR (high <= mono high and low >= mono low, judged against the whole accumulated run, not the single bar before it) is absorbed into that mono AND ENDS IT - it becomes the mono's last bar and sets its close, and the next bar starts a fresh mono whatever its colour. So a mono holds at most ONE absorbed bar and it is always the last: of two consecutive opposite-colour inside bars, only the first is absorbed. Same-colour bars are ordinary run extensions and are never tested for inside-ness. WARNING: with this ON the pane NO LONGER matches what use_mono does; it is a what-if view, not a mirror of the walk.")
one_candle   = input.bool(true,  "One candle per mono", group = "Rendering", tooltip = "ON: each run is drawn as a SINGLE candle spanning its bars, using a box for the body and a line for the wick. OFF: the v0.1.0 behaviour - plotcandle repeats the growing mono on every bar of the run (the stair). One-candle mode is limited to the most recent 500 monos by TradingView's drawing cap; repeat mode has no limit.")
show_len     = input.bool(true,  "Label runs of 2+ bars", group = "Rendering", tooltip = "Prints the bar count under each completed multi-bar mono. A trailing * means the mono ends in an absorbed opposite-colour inside bar, so it only has that shape because merge_inside is on.")
show_split   = input.bool(true,  "Mark where each run starts", group = "Rendering", tooltip = "Only applies in repeat mode - in one-candle mode the box edges already mark every boundary.")
col_up       = input.color(#2f7f6c, "Green mono", group = "Colours")
col_dn       = input.color(#a94b57, "Red mono",   group = "Colours")
col_lab      = input.color(#7c8ba0, "Labels / markers", group = "Colours")

// ════════════════ Grouping ════════════════
// Default: a mono is a maximal stretch of same-colour bars.
//
// `merge_inside` ON adds ONE clause. For a bar X of the OPPOSITE colour to the
// mono in progress:
//     X inside the mono so far (X.high <= mono high and X.low >= mono low)
//         -> X is absorbed into the mono AND ENDS IT. X becomes the mono's last
//            bar and sets its close; the bar after X starts a fresh mono
//            whatever its colour. `m_sealed` carries that across the boundary.
//     otherwise
//         -> X breaks the mono and starts its own, as it would with merging off.
//
// HOW MULTIPLE INSIDE CANDLES BEHAVE (the two cases worth knowing):
//   Consecutive OPPOSITE-colour inside bars — only the FIRST is absorbed. It
//   seals the mono, so the second starts a new mono even though it is also
//   inside. A mono therefore holds AT MOST ONE absorbed bar, always the last.
//   SAME-colour inside bars — never tested for inside-ness at all. `same_col`
//   is checked first, so they are ordinary run extensions and never seal. The
//   inside rule only ever applies to bars that flip the colour.
//
// Sealing is what keeps mono lengths sane. Without it (v0.3.0/v0.5.0) a mono
// that had grown wide kept swallowing everything that fell inside it, giving
// 27- and 26-bar monos on NEAR daily.
//
// EXPECTED SIDE EFFECT: the mono's close comes from an opposite-colour bar, so
// a green mono sealed by a red inside bar can close BELOW its own open while
// still drawn green. The mono keeps the RUN's colour, which is what a run
// means. Not a bug.
//
// CAVEAT, still open: "not inside" is symmetric here, so a bar breaks the mono
// by taking out EITHER its high or its low. The rule was specified with a green
// bar taking out the LOW as the example; low-only (mirrored to high-only for a
// red bar against a green mono) would be a narrower rule and is NOT this.
//
// HISTORY: v0.3.0 mono-based inside, absorption did not end the mono. v0.4.0
// switched both tests to single neighbour bars (wrong — only the forward one
// should have been) and added the forward-absorb clause. v0.5.0 restored the
// mono-based test. v0.6.0 made absorption end the mono. v0.7.0 REMOVES the
// forward-absorb clause entirely, which also removes the one-bar lag it forced
// and restores repeat mode under merging.
bool is_red = close < open                   // flat doji -> green, same as the walk-back

var bool  m_init   = false                   // Pine will not seed a bool with na
var bool  m_red    = false
var float m_o      = na
var float m_h      = na
var float m_l      = na
var int   m_len    = 0
var int   m_ins    = 0                       // 1 once this mono has absorbed its inside bar
var int   m_count  = 0                       // completed + current, for the data window
var int   m_start  = 0                       // bar_index the current mono began on
var int   m_t0     = 0                       // time    the current mono began on
var bool  m_sealed = false                   // mono was ENDED by absorbing an inside bar

bool same_col = m_init and is_red == m_red
bool inside_m = merge_inside and m_init and high <= m_h and low >= m_l   // vs the MONO so far

bool new_run  = false
bool seal_now = false                        // this bar closes the mono after joining it
if not m_init
    new_run  := true
else if m_sealed
    new_run  := true                         // previous mono was ENDED last bar
else if same_col
    new_run  := false                        // ordinary run extension
else if inside_m
    new_run  := false                        // absorbed by the mono...
    seal_now := true                         // ...and it also ENDS the mono
else
    new_run  := true                         // ordinary colour flip

if new_run
    m_init   := true
    m_red    := is_red
    m_o      := open
    m_h      := high
    m_l      := low
    m_len    := 1
    m_ins    := 0
    m_count  += 1
    m_start  := bar_index
    m_t0     := time
    m_sealed := false
else
    m_h   := math.max(m_h, high)
    m_l   := math.min(m_l, low)
    m_len += 1
    if not same_col
        m_ins += 1                           // absorbed only because merge_inside is on
if seal_now
    m_sealed := true                         // absorbed, and the mono is now closed

color m_col = m_red ? col_dn : col_up

// ════════════════ Render A — repeat mode (v0.1.0) ════════════════
// Fed na when one-candle mode is on, which draws nothing.
plotcandle(one_candle ? na : m_o,
     one_candle ? na : m_h,
     one_candle ? na : m_l,
     one_candle ? na : close, "Mono",
     color       = m_col,
     wickcolor   = m_col,
     bordercolor = m_col)

// ════════════════ Render B — one candle per mono ════════════════
// Body = box spanning the mono's full bar span; wick = line at its centre.
// A doji mono (open == close) gives a zero-height box, which still renders as a
// hairline because the border is drawn — the correct look for a doji.
var box  b_body = na
var line l_wick = na
// 0.38 of a bar each side = 76% of the bar span, the same body-to-gap ratio
// TradingView's own candles use. Full 0.5 would tile edge to edge with no gap
// and read as a ribbon rather than candles. The CENTRE is unchanged either way,
// so this is cosmetic only and does not affect alignment.
float half_ms = timeframe.in_seconds() * 380.0      // 0.38 bar, in milliseconds

if one_candle
    float body_t = math.max(m_o, close)
    float body_b = math.min(m_o, close)
    int   x_l    = int(m_t0 - half_ms)              // left edge of the mono's FIRST bar
    int   x_r    = int(time + half_ms)              // right edge of the mono's LAST bar
    int   x_c    = int((m_t0 + time) / 2)           // centre of the mono, for the wick
    if new_run
        b_body := box.new(x_l, body_t, x_r, body_b, xloc = xloc.bar_time,
             border_color = m_col, border_width = 1, bgcolor = m_col)
        l_wick := line.new(x_c, m_h, x_c, m_l, xloc = xloc.bar_time,
             color = m_col, width = 1)
    else
        box.set_right(b_body, x_r)                  // extend the live mono in place
        box.set_top(b_body, body_t)
        box.set_bottom(b_body, body_b)
        line.set_xy1(l_wick, x_c, m_h)
        line.set_xy2(l_wick, x_c, m_l)

// ════════════════ Annotations ════════════════
// Bar count under a completed multi-bar mono. A trailing * flags a mono that
// ends in an absorbed inside bar.
if show_len and new_run and not na(m_len[1]) and m_len[1] >= 2
    int    lx = one_candle ? int(math.round((m_start[1] + bar_index - 1) / 2.0)) : bar_index - 1
    string lt = str.tostring(m_len[1]) + (m_ins[1] > 0 ? "*" : "")
    label.new(lx, m_l[1], lt,
         yloc = yloc.price, style = label.style_label_up, size = size.tiny,
         color = color.new(color.black, 100), textcolor = col_lab)

// Faint tick where each new mono begins — redundant once the boxes draw the edges.
plotchar(show_split and new_run and not one_candle ? m_o : na, "Run start", "▏",
     location.absolute, col_lab, size = size.tiny)

// ════════════════ Data window ════════════════
plot(m_o,     "DW mono open",         display = display.data_window)
plot(m_h,     "DW mono high",         display = display.data_window)
plot(m_l,     "DW mono low",          display = display.data_window)
plot(close,   "DW mono close",        display = display.data_window)
plot(m_len,   "DW bars in this mono", display = display.data_window)
plot(m_ins,   "DW inside bars absorbed", display = display.data_window)
plot(m_sealed ? 1 : 0, "DW mono sealed (1=ended by inside bar)", display = display.data_window)
plot(m_red ? 1 : 0, "DW is red (1=red)", display = display.data_window)
plot(m_count, "DW monos so far",      display = display.data_window)

// ════════════════ Version tag ════════════════
var table vt = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(vt, 0, 0, "Jamal Mono v" + SCRIPT_V, text_color = color.white, bgcolor = color.new(color.black, 20))
