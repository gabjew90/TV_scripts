//@version=6
indicator("Jamal Mono v1.0.0", shorttitle = "JMono1.0", overlay = false,
     max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

// ════════════════ Identity ════════════════
SCRIPT_V = "1.0.0"

// ════════════════ What this is ════════════════
// A separate-pane candle chart of MONOLITHIC candles — bars merged into groups
// and drawn as one candle each, so the grouping can be read directly instead of
// inferred from levels.
//
// A mono is drawn as:
//     open  = the group's FIRST (oldest) bar's open
//     close = the group's LAST (newest) bar's close
//     high  = highest high across the group
//     low   = lowest low across the group
// Colour convention matches the jamal-ob walk-back exactly: RED is close < open,
// so a FLAT DOJI (close == open) counts as GREEN.
//
// TWO RENDERERS (v0.2.0), chosen by `one_candle`... see Rendering below.
//
// X-AXIS ALIGNMENT: the box renderer uses `xloc.bar_time` with a sub-bar offset
// either side of the group, so a mono covering bars L..R is centred on exactly
// the span those bars occupy in the price pane above. `xloc.bar_index` would put
// the edges on bar CENTRES, making every mono half a bar narrow and collapsing
// single-bar monos to zero width. The offset assumes evenly spaced bars, which
// holds on 24/7 crypto; on a session-gapped symbol the edges drift across
// weekend and holiday gaps.
//
// Y-AXIS SCALING is NOT under this script's control — see Pane scaling below.
//
// NO LAG, NO LOOKAHEAD. Every rule reads only the bar being drawn and state
// accumulated before it.
//
// DRAWING LIMITS: 500 boxes and 500 lines, so the box renderer shows the most
// recent ~500 monos and TradingView drops older ones. On a chart with more monos
// than that the early history renders empty in one-candle mode; switch the
// renderer off to see all of it.

// ════════════════ Inputs — exactly TWO toggles, then plain settings ═════════
merge_color  = input.bool(true,  "Merge consecutive same-colour candles", group = "Grouping", tooltip = "The classic monolithic rule, and the grouping the jamal-ob use_mono walk-back runs on: a mono is a maximal stretch of consecutive same-colour bars. Turn OFF to group ONLY by the inside rule.")
merge_inside = input.bool(false, "Merge inside candles", group = "Grouping", tooltip = "A bar is absorbed into the current mono when it is an INSIDE BAR relative to THE BAR IMMEDIATELY BEFORE IT - high <= previous high AND low >= previous low. Judged against that single preceding bar, NOT against the mono's accumulated range, so an absorbed group is a nested chain. Colour is irrelevant to this rule.")
body_pct     = input.float(76, "Candle body width (% of bar span)", minval = 20, maxval = 100, step = 2, group = "Rendering", tooltip = "76% matches TradingView's own candle body-to-gap ratio. 100% tiles the monos edge to edge with no gap, which reads as a ribbon. Cosmetic only - the CENTRE of each mono is unchanged, so alignment with the price pane is unaffected.")
one_candle   = input.bool(true,  "One candle per mono", group = "Rendering", tooltip = "ON: each mono is drawn as a SINGLE candle spanning its bars, using a box for the body and a line for the wick. OFF: plotcandle repeats the growing mono on every bar of the group (a stair), because plotcandle is one-value-per-bar and cannot span bars. One-candle mode is capped at the most recent 500 monos by TradingView's drawing limit; repeat mode has no limit.")
wick_w       = input.int(2, "Wick thickness", minval = 1, maxval = 4, group = "Rendering")
label_min    = input.int(3, "Label monos of N+ bars (0 = no labels)", minval = 0, group = "Rendering", tooltip = "Prints the bar count under each mono at least this long. A trailing * means the mono contains at least one bar that joined ONLY because of the inside rule. Raise it if labels crowd the pane; 0 turns them off.")
col_up       = input.color(#2f7f6c, "Green mono", group = "Colours")
col_dn       = input.color(#a94b57, "Red mono",   group = "Colours")
col_lab      = input.color(#7c8ba0, "Labels", group = "Colours")

// ════════════════ Grouping (v1.0.0) ════════════════
// TWO INDEPENDENT MERGE RULES. A bar CONTINUES the current mono if either rule
// accepts it, and starts a new mono if neither does:
//     COLOUR rule  (merge_color)  — the bar is the same colour as the mono.
//     INSIDE rule  (merge_inside) — the bar is inside the bar IMMEDIATELY
//                                   BEFORE IT: high <= high[1] and low >= low[1].
// That is the whole grouping. The two compose without special cases, which is
// the point of stating them this way:
//     colour ON,  inside OFF  -> classic colour runs; matches use_mono.
//     colour ON,  inside ON   -> colour runs that also swallow inside bars,
//                                including opposite-colour ones.
//     colour OFF, inside ON   -> a mono is a bar plus the nested inside chain
//                                that follows it, colour ignored entirely.
//     both OFF                -> one mono per bar; the pane mirrors price.
//
// "INSIDE" IS AGAINST THE PREVIOUS SINGLE BAR (v1.0.0), not the mono's
// accumulated high/low as in v0.3.0-v0.8.0. An absorbed group is therefore a
// NESTED CHAIN, each bar contained by the one before it. This is strictly
// narrower than "contained by the run": a mono that has grown wide no longer
// counts as containment on its own, which is what caused the runaway 27- and
// 26-bar monos under the old test.
//
// The no-widening property holds: bar[1] is already in the mono, so the mono's
// range contains it, so anything inside bar[1] is inside the mono too. A bar
// joining via the INSIDE rule can never extend the mono's high or low.
//
// DROPPED IN v1.0.0: absorbing an inside bar used to also END the mono (the
// v0.6.0-v0.8.0 `m_sealed` / absorption-group machinery). It existed because
// "inside" was measured against the whole mono back then, so without a stop the
// mono swallowed everything. Measuring against the previous bar removes that
// failure mode structurally — nested chains shrink and terminate on their own —
// and a sealing rule would not compose cleanly with two independent toggles.
//
// EXPECTED SIDE EFFECT: a mono's close comes from its last bar whatever that
// bar's colour, so a green mono ending in an absorbed red inside bar can close
// BELOW its own open while still drawn green. The mono keeps the colour of the
// bar that STARTED it. Not a bug.
//
// CAVEAT, still open: "inside" is symmetric — a bar fails the test by taking out
// EITHER the previous bar's high or its low. The rule was originally described
// with a green bar taking out the LOW as the example; low-only (mirrored to
// high-only for a red bar) would be narrower and is NOT what this implements.
bool is_red = close < open                   // flat doji -> green, same as the walk-back

var bool  m_init  = false                    // Pine will not seed a bool with na
var bool  m_red   = false
var float m_o     = na
var float m_h     = na
var float m_l     = na
var int   m_len   = 0
var int   m_ins   = 0                        // bars that joined ONLY via the inside rule
var int   m_count = 0                        // completed + current, for the data window
var int   m_start = 0                        // bar_index the current mono began on
var int   m_t0    = 0                        // time    the current mono began on

bool join_color  = merge_color  and m_init and is_red == m_red
bool join_inside = merge_inside and m_init and high <= high[1] and low >= low[1]
bool new_run     = not m_init or not (join_color or join_inside)

if new_run
    m_init  := true
    m_red   := is_red                        // the mono takes the colour of the bar that STARTS it
    m_o     := open
    m_h     := high
    m_l     := low
    m_len   := 1
    m_ins   := 0
    m_count += 1
    m_start := bar_index
    m_t0    := time
else
    m_h   := math.max(m_h, high)             // a no-op for an inside-rule join, by definition
    m_l   := math.min(m_l, low)
    m_len += 1
    if not join_color
        m_ins += 1                           // joined only because merge_inside is on

color m_col = m_red ? col_dn : col_up

// ════════════════ Render A — repeat mode ════════════════
// Fed na when one-candle mode is on, which draws nothing.
plotcandle(one_candle ? na : m_o,
     one_candle ? na : m_h,
     one_candle ? na : m_l,
     one_candle ? na : close, "Mono",
     color       = m_col,
     wickcolor   = m_col,
     bordercolor = m_col)

// ════════════════ Render B — one candle per mono ════════════════
// Body = box spanning the mono's full bar span; wick = line at its centre.
// A doji mono (open == close) gives a zero-height box, which still renders as a
// hairline because the border is drawn — the correct look for a doji.
var box  b_body = na
var line l_wick = na
// Half the body width, in milliseconds. `body_pct` of the bar span, so the
// CENTRE is unchanged whatever the width and alignment is unaffected.
float half_ms = timeframe.in_seconds() * 1000.0 * (body_pct / 200.0)

if one_candle
    float body_t = math.max(m_o, close)
    float body_b = math.min(m_o, close)
    int   x_l    = int(m_t0 - half_ms)              // left edge of the mono's FIRST bar
    int   x_r    = int(time + half_ms)              // right edge of the mono's LAST bar
    int   x_c    = int((m_t0 + time) / 2)           // centre of the mono, for the wick
    if new_run
        b_body := box.new(x_l, body_t, x_r, body_b, xloc = xloc.bar_time,
             border_color = m_col, border_width = 1, bgcolor = m_col)
        l_wick := line.new(x_c, m_h, x_c, m_l, xloc = xloc.bar_time,
             color = m_col, width = wick_w)
    else
        box.set_right(b_body, x_r)                  // extend the live mono in place
        box.set_top(b_body, body_t)
        box.set_bottom(b_body, body_b)
        line.set_xy1(l_wick, x_c, m_h)
        line.set_xy2(l_wick, x_c, m_l)

// ════════════════ Pane scaling — NOT SOLVED, do not retry blindly ════════════
// Boxes and lines are DRAWINGS and do not drive a pane's price scale; only plots
// do. Two attempts to anchor the scale with hidden plots of m_h/m_l both failed
// and were removed:
//   100% transparent — compiles and runs, but TradingView drops fully
//     transparent plots from auto-scaling, so toggling it moved the axis not at
//     all (measured on NEAR 1D: an identical 1.000-3.000 axis either way).
//   97% transparent  — put the study into a RUNTIME error and the pane went
//     blank. Not diagnosed; the error text was not reachable from the legend.
// The dead space costs roughly 16% of the pane on NEAR 1D, which is not worth
// breaking the render for. Pane HEIGHT, which matters more, is a chart-level
// setting Pine cannot touch at all — drag the pane divider.

// ════════════════ Annotations ════════════════
// Bar count under a completed mono. A trailing * flags a mono containing at
// least one bar that joined only via the inside rule.
if label_min > 0 and new_run and not na(m_len[1]) and m_len[1] >= label_min
    int    lx = one_candle ? int(math.round((m_start[1] + bar_index - 1) / 2.0)) : bar_index - 1
    string lt = str.tostring(m_len[1]) + (m_ins[1] > 0 ? "*" : "")
    label.new(lx, m_l[1], lt,
         yloc = yloc.price, style = label.style_label_up, size = size.tiny,
         color = color.new(color.black, 100), textcolor = col_lab)

// ════════════════ Data window ════════════════
plot(m_o,     "DW mono open",         display = display.data_window)
plot(m_h,     "DW mono high",         display = display.data_window)
plot(m_l,     "DW mono low",          display = display.data_window)
plot(close,   "DW mono close",        display = display.data_window)
plot(m_len,   "DW bars in this mono", display = display.data_window)
plot(m_ins,   "DW joined via inside rule", display = display.data_window)
plot(m_red ? 1 : 0, "DW is red (1=red)", display = display.data_window)
plot(m_count, "DW monos so far",      display = display.data_window)

// ════════════════ Version tag ════════════════
var table vt = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(vt, 0, 0, "Jamal Mono v" + SCRIPT_V, text_color = color.white, bgcolor = color.new(color.black, 20))
