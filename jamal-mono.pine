//@version=6
indicator("Jamal Mono v2.0.1", shorttitle = "JMono2.0", overlay = true, max_boxes_count = 500)

// ════════════════ Identity ════════════════
SCRIPT_V = "2.0.1"

// ════════════════ What this is (v2.0.0 — clean restart) ════════════════
// ONE rule, no toggles. A bar joins the current monolithic candle when it is an
// INSIDE bar relative to the INDIVIDUAL candle immediately to its left:
//     high <= previous high  AND  low >= previous low
// Colour does not matter. A bar that is NOT inside its left neighbour starts a
// new mono.
//
// DIRECTION NOTE: the rule was specified right-to-left (most recent first, a
// chain of inside candles absorbing from the newest end). Because containment
// NESTS — if C is inside B and B is inside A, C is inside A — a chain collapses
// to the same group whichever end you sweep from. The cut points are exactly
// the bars that are not inside their left neighbour, so this single forward
// pass produces the identical grouping.
//
// VISUAL: overlay shading on the price chart, in the style of the Day of Week
// Shading indicator. Each mono of 2+ bars is drawn as a translucent full-height
// vertical band over the candles it spans; single-bar monos are left unshaded.
// Adjacent bands alternate between two colours so back-to-back groups stay
// distinguishable. Bands are BOXES, not bgcolor, because bgcolor cannot be
// applied retroactively — a mono's first bar is only known to be in a group
// once its second bar arrives, and a box created at that moment can span both.
// Boxes are drawings and do not drive the price scale, so the tall bounds used
// to fill the pane cannot stretch the chart's scaling.
//
// The band's left/right edges sit half a bar beyond the mono's first and last
// bar times, so the shading covers those bars fully. Assumes evenly spaced
// bars (true on 24/7 crypto).
//
// NO LAG, NO LOOKAHEAD. The live bar can still flip intrabar (a new high or
// low can break it out of the chain); Pine's rollback handles that.
//
// DRAWING LIMIT: 500 boxes = the most recent 500 multi-bar monos. NEAR 1D has
// ~360 in the full loaded history, so the cap is not binding there.

// ════════════════ Inputs ════════════════
col_a = input.color(color.new(#5c7cba, 74), "Band colour A")
col_b = input.color(color.new(#c4901a, 74), "Band colour B")

// ════════════════ Grouping ════════════════
bool inside_prev = bar_index > 0 and high <= high[1] and low >= low[1]

var int m_len   = 0                          // bars in the current mono
var int m_count = 0                          // monos so far (completed + current)
var int m_t0    = 0                          // time of the current mono's first bar
var int m_bands = 0                          // multi-bar monos so far — drives colour alternation

bool new_run = not inside_prev
if new_run
    m_count += 1
    m_len   := 1
    m_t0    := time
else
    m_len += 1

// ════════════════ Render — full-height band per multi-bar mono ════════════════
var box b_band = na
float half_ms  = timeframe.in_seconds() * 500.0     // half a bar, in ms

if not new_run
    if m_len == 2                            // mono just became multi-bar — band starts now
        m_bands += 1
        color bc = m_bands % 2 == 0 ? col_a : col_b
        // v2.0.1: 50x above and below price stands in for "full height". The
        // v2.0.0 bounds (1e12 / 1e-10) existed in the box model but rendered
        // NOTHING - TradingView culls boxes with coordinates that extreme. A
        // +/-50x envelope covers any realistic zoom, and boxes do not drive
        // the price scale, so these bounds cannot stretch the chart.
        b_band := box.new(int(m_t0 - half_ms), close * 50, int(time + half_ms), close / 50,
             xloc = xloc.bar_time, border_width = 0, bgcolor = bc)
    else
        box.set_right(b_band, int(time + half_ms))  // chain keeps growing

// ════════════════ Data window ════════════════
plot(m_len,   "DW bars in this mono", display = display.data_window)
plot(m_count, "DW monos so far",      display = display.data_window)
plot(inside_prev ? 1 : 0, "DW inside prev (1=yes)", display = display.data_window)

// ════════════════ Version tag ════════════════
var table vt = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(vt, 0, 0, "Jamal Mono v" + SCRIPT_V, text_color = color.white, bgcolor = color.new(color.black, 20))
