//@version=6
indicator("Jamal Mono v2.6.1", shorttitle = "JMono2.6", overlay = false,
     max_boxes_count = 500, max_lines_count = 500)

// ════════════════ Identity ════════════════
SCRIPT_V = "2.6.1"

// ════════════════ What this is ════════════════
// THREE-STAGE grouping, no toggles (v2.6.0):
//
// STAGE 1 — INSIDE / ANCHOR (v2.2.0 rule, unchanged). The first candle of a
// group is its ANCHOR; every subsequent candle joins while it is inside the
// anchor's range (high <= anchor high AND low >= anchor low); the first candle
// to poke outside starts a new group as the new anchor. Colour is irrelevant.
// A stage-1 mono's high/low ARE its anchor's; its open is the anchor's open;
// its close is its newest bar's close.
//
// STAGE 2 — COLOUR, applied ON TOP of stage 1. Each stage-1 mono has a colour:
// RED if its close < its open, otherwise GREEN (a flat doji counts green, the
// jamal-ob convention). Consecutive same-colour stage-1 monos merge into the
// FINAL monolithic candle: open = first inner mono's open, close = last inner
// mono's close, high/low = the extremes across the merged inner monos (stage 2
// CAN widen past a single anchor, unlike stage 1).
//
// STAGE 3 — LONE SINGLES (v2.6.0). A final that completes as ONE BAR never
// survives on its own, regardless of colour:
//   a) if its range is inside the PRECEDING final's range (high <= its high
//      AND low >= its low), the preceding mono ABSORBS it — that mono extends
//      by one bar and its close becomes the single's close;
//   b) otherwise it merges FORWARD into the following final, becoming its
//      opening bar (the merged final's open and first bar are the single's).
// The two same-colour finals this leaves adjacent are NOT re-merged: the
// boundary marks where the swallowed single was. For future stage-2 decisions
// a final's colour stays that of its stage-1 members; the swallowed single is
// an impurity that shifts only the OHLC. Everything stays causal: a single is
// only known to be lone when the next differently-coloured stage-1 mono
// finalizes, so at the live edge a single may display until that happens.
//
// LIVE BEHAVIOUR: the live inner mono's close moves, so its colour can flip,
// which can attach it to or detach it from the final mono under construction.
// The renderer handles that by re-drawing the affected boxes in place. Nothing
// looks ahead; Pine's rollback handles intrabar flips.
//
// VISUAL: every final mono is drawn AS A CANDLE in this indicator's own pane
// below the chart — translucent body box (open..close), centre wick line
// (high..low), coloured by the final mono's live direction. The pane shares
// the bar axis with the chart; two invisible high/low plots anchor its price
// scale, since boxes and lines do not participate in pane autoscaling.
//
// DRAWING LIMIT: 500 boxes/lines = the most recent 500 final monos.

// ════════════════ Inputs ════════════════
col_up   = input.color(#26a69a, "Mono up",   group = "Colours")
col_dn   = input.color(#ef5350, "Mono down", group = "Colours")
fill_tr  = input.int(70, "Body fill transparency", minval = 0, maxval = 100, group = "Colours", tooltip = "The body is filled at this transparency so the real candles stay visible through it. The border and wick are drawn solid.")

float half_ms = timeframe.in_seconds() * 500.0   // half a bar, in ms (box edges sit at ±half a bar)

// ════════════════ Stage 1 state — the live inner (anchor) mono L ════════════
var float a_o   = na                         // anchor open  = L's open
var float a_h   = na                         // anchor high  = L's high
var float a_l   = na                         // anchor low   = L's low
var int   a_t0  = 0                          // time of the anchor bar
var int   a_len = 0                          // bars in L
var int   a_cnt = 0                          // stage-1 monos so far
var bool  prev_l_red = false                 // L's colour as of the previous bar (locks on finalize)

// ════════════════ Stage 2 state — the final mono under construction F ═══════
// F holds the already-FINALIZED inner monos of the current final candle. The
// live inner mono L is displayed attached to F whenever their colours match,
// and becomes part of F only when L finalizes still matching.
var bool  f_exists = false
var bool  f_red    = false                   // colour of F's member inner monos
var float f_o = na                           // F's open (first inner's open)
var float f_c = na                           // F's close (last finalized inner's close)
var float f_h = na
var float f_l = na
var int   f_t0  = 0                          // time of F's first bar
var int   f_t1  = 0                          // time of F's last bar
var int   f_len = 0                          // bars in F
var int   f_cnt = 0                          // final monos so far (started)

// ════════════════ Stage 3 state — the committed PRECEDING final P ═══════════
// Kept so a lone single that completes inside P's range can be absorbed
// backward: P's box is re-extended in place. P is always the newest committed
// final, so its drawing can never have been evicted by the 500 cap.
var bool  p_exists = false
var float p_o = na
var float p_c = na
var float p_h = na
var float p_l = na
var int   p_t0 = 0
var int   p_t1 = 0

var box  boxF  = na                          // drawing for F (or F∪L while attached)
var line wickF = na
var box  boxL  = na                          // drawing for L alone while detached
var line wickL = na
var box  boxP  = na                          // drawing for the committed P
var line wickP = na

// ════════════════ Grouping ════════════════
bool inside_anchor = a_cnt > 0 and high <= a_h and low >= a_l
bool new_inner     = not inside_anchor

if new_inner
    if a_cnt > 0                             // finalize the previous L with its locked colour
        if f_exists and prev_l_red == f_red
            f_c   := close[1]                // stage 2: L absorbed into F
            f_h   := math.max(f_h, a_h)
            f_l   := math.min(f_l, a_l)
            f_t1  := time[1]
            f_len += a_len
        else                                 // F is complete — stage 3 decides its fate
            bool lone_f   = f_exists and f_len == 1
            bool eat_back = lone_f and p_exists and f_h <= p_h and f_l >= p_l
            if eat_back
                // STAGE 3a: the lone F is inside P — P absorbs it backward
                p_c  := f_c
                p_t1 := f_t1
                if not na(boxP)
                    color pc_  = p_c >= p_o ? col_up : col_dn
                    int   px_c = int((p_t0 + p_t1) / 2)
                    box.set_right(boxP, int(p_t1 + half_ms))
                    box.set_top(boxP, math.max(p_o, p_c))
                    box.set_bottom(boxP, math.min(p_o, p_c))
                    box.set_border_color(boxP, pc_)
                    box.set_bgcolor(boxP, color.new(pc_, fill_tr))
                    line.set_xy1(wickP, px_c, p_h)
                    line.set_xy2(wickP, px_c, p_l)
                    line.set_color(wickP, pc_)
                box.delete(boxF)             // the single's own drawing goes
                line.delete(wickF)
                // L becomes the new F (P stays P; the dissolved single never becomes P)
                f_red := prev_l_red
                f_o  := a_o
                f_c  := close[1]
                f_h  := a_h
                f_l  := a_l
                f_t0 := a_t0
                f_t1 := time[1]
                f_len := a_len               // f_cnt net unchanged: −1 dissolved, +1 started
                boxF  := boxL
                wickF := wickL
                boxL  := na
                wickL := na
            else if lone_f
                // STAGE 3b: the lone F merges forward — it becomes the opening
                // bar of L's final. f_o, f_t0 (and f_cnt) stay the single's.
                f_red := prev_l_red
                f_c   := close[1]
                f_h   := math.max(f_h, a_h)
                f_l   := math.min(f_l, a_l)
                f_t1  := time[1]
                f_len += a_len
                box.delete(boxF)             // the single's own drawing goes
                line.delete(wickF)
                boxF  := boxL                // L's drawing becomes the merged final's
                wickF := wickL
                boxL  := na
                wickL := na
            else
                // multi-bar F commits and becomes P; L becomes the new F
                if f_exists
                    p_exists := true
                    p_o  := f_o
                    p_c  := f_c
                    p_h  := f_h
                    p_l  := f_l
                    p_t0 := f_t0
                    p_t1 := f_t1
                    boxP  := boxF            // hand P the committed drawing
                    wickP := wickF
                f_exists := true
                f_red    := prev_l_red
                f_o  := a_o
                f_c  := close[1]
                f_h  := a_h
                f_l  := a_l
                f_t0 := a_t0
                f_t1 := time[1]
                f_len := a_len
                f_cnt += 1
                boxF  := boxL                // the committed F keeps its drawing; L's becomes F's
                wickF := wickL
                boxL  := na
                wickL := na
    a_o   := open                            // start the new inner mono — this bar is the anchor
    a_h   := high
    a_l   := low
    a_t0  := time
    a_len := 1
    a_cnt += 1
else
    a_len += 1

bool l_red = close < a_o                     // L's LIVE colour (doji -> green)

// ════════════════ Render ════════════════
// v2.6.1: the series' first bar time. The chart's FIRST mono must not put its
// box edge at `first bar - half a bar` — that timestamp predates the series,
// and TradingView's mobile renderer extends such a box indefinitely to the
// left (caught by the user on HYPE 1D in jamal-mono-v1; same pattern here).
var int t_series0 = 0
if barstate.isfirst
    t_series0 := time

int  x_r      = int(time + half_ms)
bool attached = f_exists and l_red == f_red  // L currently displays as part of F's final mono

if attached
    // ONE candle covering F ∪ L
    float o  = f_o
    float h  = math.max(f_h, a_h)
    float l  = math.min(f_l, a_l)
    color mc = close >= o ? col_up : col_dn
    int  x_l = math.max(int(f_t0 - half_ms), t_series0)
    int  x_c = int((f_t0 + time) / 2)
    if not na(boxL)                          // was detached — drop L's own drawing
        box.delete(boxL)
        line.delete(wickL)
        boxL  := na
        wickL := na
    if na(boxF)                              // F∪L always spans 2+ bars
        boxF  := box.new(x_l, math.max(o, close), x_r, math.min(o, close), xloc = xloc.bar_time,
             border_color = mc, border_width = 1, bgcolor = color.new(mc, fill_tr))
        wickF := line.new(x_c, h, x_c, l, xloc = xloc.bar_time, color = mc, width = 2)
    else
        box.set_left(boxF, x_l)
        box.set_right(boxF, x_r)
        box.set_top(boxF, math.max(o, close))
        box.set_bottom(boxF, math.min(o, close))
        line.set_xy1(wickF, x_c, h)
        line.set_xy2(wickF, x_c, l)
    box.set_border_color(boxF, mc)
    box.set_bgcolor(boxF, color.new(mc, fill_tr))
    line.set_color(wickF, mc)
else
    // F stands alone (drawn at ANY length — the pane has no real candles
    // underneath; a lone F displays until stage 3 resolves it)...
    if f_exists
        color fc_ = f_c >= f_o ? col_up : col_dn
        int  fx_l = math.max(int(f_t0 - half_ms), t_series0)
        int  fx_r = int(f_t1 + half_ms)
        int  fx_c = int((f_t0 + f_t1) / 2)
        if na(boxF)
            boxF  := box.new(fx_l, math.max(f_o, f_c), fx_r, math.min(f_o, f_c), xloc = xloc.bar_time,
                 border_color = fc_, border_width = 1, bgcolor = color.new(fc_, fill_tr))
            wickF := line.new(fx_c, f_h, fx_c, f_l, xloc = xloc.bar_time, color = fc_, width = 2)
        else                                 // shrink back from a previously attached display
            box.set_left(boxF, fx_l)
            box.set_right(boxF, fx_r)
            box.set_top(boxF, math.max(f_o, f_c))
            box.set_bottom(boxF, math.min(f_o, f_c))
            line.set_xy1(wickF, fx_c, f_h)
            line.set_xy2(wickF, fx_c, f_l)
        box.set_border_color(boxF, fc_)
        box.set_bgcolor(boxF, color.new(fc_, fill_tr))
        line.set_color(wickF, fc_)
    // ...and L is its own provisional final mono, drawn at any length too
    color lc_ = close >= a_o ? col_up : col_dn
    int  lx_l = math.max(int(a_t0 - half_ms), t_series0)
    int  lx_c = int((a_t0 + time) / 2)
    if na(boxL)
        boxL  := box.new(lx_l, math.max(a_o, close), x_r, math.min(a_o, close), xloc = xloc.bar_time,
             border_color = lc_, border_width = 1, bgcolor = color.new(lc_, fill_tr))
        wickL := line.new(lx_c, a_h, lx_c, a_l, xloc = xloc.bar_time, color = lc_, width = 2)
    else
        box.set_left(boxL, lx_l)
        box.set_right(boxL, x_r)
        box.set_top(boxL, math.max(a_o, close))
        box.set_bottom(boxL, math.min(a_o, close))
        line.set_xy1(wickL, lx_c, a_h)
        line.set_xy2(wickL, lx_c, a_l)
        box.set_border_color(boxL, lc_)
        box.set_bgcolor(boxL, color.new(lc_, fill_tr))
        line.set_color(wickL, lc_)

prev_l_red := l_red                          // lock-in candidate for the finalize step

// ════════════════ Pane scale anchors ════════════════
// Invisible plots of the bar high/low. Boxes/lines do not drive a pane's
// autoscale, so without these the pane would not scale to the mono candles.
plot(high, "Scale anchor high", color.new(color.gray, 100), editable = false)
plot(low,  "Scale anchor low",  color.new(color.gray, 100), editable = false)

// ════════════════ Data window ════════════════
plot(a_cnt, "DW stage-1 monos so far", display = display.data_window)
plot(f_cnt, "DW final monos so far",   display = display.data_window)
plot(a_len, "DW bars in live inner",   display = display.data_window)
plot(f_len, "DW bars committed to current final", display = display.data_window)
plot(attached ? 1 : 0, "DW live inner attached (1=yes)", display = display.data_window)

// ════════════════ Version tag ════════════════
var table vt = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(vt, 0, 0, "Jamal Mono v" + SCRIPT_V, text_color = color.white, bgcolor = color.new(color.black, 20))
