//@version=6
indicator("Jamal Mono v2.2.0", shorttitle = "JMono2.2", overlay = true,
     max_boxes_count = 500, max_lines_count = 500)

// ════════════════ Identity ════════════════
SCRIPT_V = "2.2.0"

// ════════════════ What this is ════════════════
// ONE rule, no toggles. The first candle of a mono is its ANCHOR. Every
// subsequent candle joins the mono while it is INSIDE THE ANCHOR's range:
//     high <= anchor high  AND  low >= anchor low
// Colour does not matter. The first candle that pokes outside the anchor's
// range starts a new mono and becomes the new anchor.
//
// v2.2.0 DIRECTION CHANGE (user-specified): the test is LEFT TO RIGHT — each
// candle absorbs all subsequent candles inside ITSELF. v2.0.x/v2.1.0 tested
// each bar against its IMMEDIATE PREDECESSOR instead, which only absorbs
// nested chains (each bar inside the one before it). Anchor-based absorption
// is strictly broader: a bar can be inside the anchor without being inside
// the bar right before it — e.g. a wide anchor followed by small alternating
// bars that overlap each other but all sit within the anchor's range. Under
// the pairwise rule that chain breaks at the first non-nested step; under the
// anchor rule the whole consolidation joins the anchor's mono.
//
// Because every absorbed bar is inside the anchor, the mono's high/low ARE the
// anchor's high/low — absorption can never widen the mono.
//
// VISUAL: each mono of 2+ bars is drawn AS A CANDLE over the price chart:
//     body = translucent box from the mono's OPEN (the anchor's open) to its
//            CLOSE (newest bar's close), spanning the mono's bars
//     wick = line at the mono's centre from its HIGH to its LOW (the anchor's)
//     colour = the mono's own direction, green if close >= open, red otherwise,
//              updating live as the mono's close moves
// Single-bar monos are not drawn — the real candle already shows them.
//
// The box/wick edges use `xloc.bar_time` with a half-bar offset so the mono
// covers its bars fully. Assumes evenly spaced bars (true on 24/7 crypto).
// Boxes and lines are drawings and do not drive the price scale.
//
// NO LAG, NO LOOKAHEAD. The live bar can still flip intrabar (a new high or
// low can poke outside the anchor); Pine's rollback handles that.
//
// DRAWING LIMIT: 500 boxes/lines = the most recent ~500 multi-bar monos.

// ════════════════ Inputs ════════════════
col_up   = input.color(#26a69a, "Mono up",   group = "Colours")
col_dn   = input.color(#ef5350, "Mono down", group = "Colours")
fill_tr  = input.int(70, "Body fill transparency", minval = 0, maxval = 100, group = "Colours", tooltip = "The body is filled at this transparency so the real candles stay visible through it. The border and wick are drawn solid.")

// ════════════════ Grouping ════════════════
var int   m_len   = 0                        // bars in the current mono
var int   m_count = 0                        // monos so far (completed + current)
var float m_o     = na                       // the anchor's open
var float m_h     = na                       // the anchor's high = the mono's high
var float m_l     = na                       // the anchor's low  = the mono's low
var int   m_t0    = 0                        // time of the anchor bar

bool inside_anchor = m_count > 0 and high <= m_h and low >= m_l

bool new_run = not inside_anchor
if new_run
    m_count += 1
    m_len   := 1
    m_o     := open
    m_h     := high
    m_l     := low
    m_t0    := time
else
    m_len += 1

// ════════════════ Render — the mono as a candle over the price chart ════════
var box  b_body = na
var line l_wick = na
float half_ms   = timeframe.in_seconds() * 500.0    // half a bar, in ms

if not new_run
    color mc     = close >= m_o ? col_up : col_dn   // the mono's own direction, live
    float body_t = math.max(m_o, close)
    float body_b = math.min(m_o, close)
    int   x_r    = int(time + half_ms)              // right edge of the mono's last bar
    int   x_c    = int((m_t0 + time) / 2)           // centre of the mono, for the wick
    if m_len == 2                                   // mono just became multi-bar — draw it now
        b_body := box.new(int(m_t0 - half_ms), body_t, x_r, body_b, xloc = xloc.bar_time,
             border_color = mc, border_width = 1, bgcolor = color.new(mc, fill_tr))
        l_wick := line.new(x_c, m_h, x_c, m_l, xloc = xloc.bar_time, color = mc, width = 2)
    else                                            // mono keeps growing — extend in place
        box.set_right(b_body, x_r)
        box.set_top(b_body, body_t)
        box.set_bottom(b_body, body_b)
        line.set_xy1(l_wick, x_c, m_h)
        line.set_xy2(l_wick, x_c, m_l)
    box.set_border_color(b_body, mc)                // direction can flip while the mono grows
    box.set_bgcolor(b_body, color.new(mc, fill_tr))
    line.set_color(l_wick, mc)

// ════════════════ Data window ════════════════
plot(m_o,     "DW mono open",         display = display.data_window)
plot(m_h,     "DW mono high",         display = display.data_window)
plot(m_l,     "DW mono low",          display = display.data_window)
plot(close,   "DW mono close",        display = display.data_window)
plot(m_len,   "DW bars in this mono", display = display.data_window)
plot(m_count, "DW monos so far",      display = display.data_window)

// ════════════════ Version tag ════════════════
var table vt = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(vt, 0, 0, "Jamal Mono v" + SCRIPT_V, text_color = color.white, bgcolor = color.new(color.black, 20))
